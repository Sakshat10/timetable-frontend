# Copy to .env.local (never commit .env.local).
#
# Origin of the Fastify backend, without /api. Server-only: the browser never sees it.
# Local development backend:        http://127.0.0.1:4000
# Disposable e2e backend (testing): http://127.0.0.1:4010
# Read at build time (rewrite destination) and at runtime (server components).
BACKEND_URL=http://127.0.0.1:4000
